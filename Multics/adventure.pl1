/* adventure -- the command that runs Adventure 1.2 (462 points).
   Written 2026 for adv462.  In 1980 the Fortran program was adventure_, and
   a command named adventure (which did not survive) presumably ran it: the
   Multics Fortran compiler gives a main program the entry point main_, not
   the segment's name, so adventure_ cannot be typed as a command itself.

   Usage:  adventure

   The game's own stop statements end the command; the cleanup handler then
   detaches the database switch (file01) so the next game can attach it. */

adventure:
     procedure;

adv462:
     entry;				/* the same command under the name adv462 */

dcl	adventure_$main_	entry;
dcl	advdet		entry;
dcl	cleanup		condition;

	on cleanup call advdet;
	call adventure_$main_;
	call advdet;
	return;

     end adventure;
